# =============================================================================
# Deployment Metrics Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Source with: export $(grep -v '^#' .env | xargs)
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment Script Configuration
# -----------------------------------------------------------------------------

# Environment name (production, staging, development)
ENV=production

# Service name
SERVICE=cubase-script-assistant

# Deployment trigger source (manual, jenkins, github-actions, gitlab-ci)
TRIGGERED_BY=manual

# Health check endpoint
HEALTH_CHECK_URL=http://localhost:5001/

# Number of health check retries
HEALTH_CHECK_RETRIES=5

# Seconds between health check attempts
HEALTH_CHECK_INTERVAL=2

# Number of smoke test iterations
SMOKE_TEST_ITERATIONS=3

# Latency threshold in seconds (warn if exceeded)
LATENCY_THRESHOLD=20

# -----------------------------------------------------------------------------
# Metrics API Configuration
# -----------------------------------------------------------------------------

# URL where the metrics API is running
METRICS_API_URL=http://localhost:8080

# Path to metrics JSONL file
METRICS_LOG=./metrics/deployment_metrics.jsonl

# -----------------------------------------------------------------------------
# Alert Configuration
# -----------------------------------------------------------------------------

# Slack incoming webhook URL
# Create at: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=<your-slack-webhook-url-here>

# Microsoft Teams webhook URL (optional)
# Create at: Connectors > Incoming Webhook in Teams channel
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# PagerDuty Events API v2 routing key (optional)
# For critical alerts only
# PAGERDUTY_ROUTING_KEY=your-routing-key-here

# -----------------------------------------------------------------------------
# Grafana Configuration
# -----------------------------------------------------------------------------

# Grafana dashboard URL (for alert links)
GRAFANA_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Monitoring Configuration
# -----------------------------------------------------------------------------

# Number of days to check for health monitoring
CHECK_DAYS=7

# Number of days for daily digest (1 = yesterday only)
DIGEST_DAYS=1
