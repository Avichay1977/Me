{
  "manifest_version": 3,
  "name": "YT SimulDub HE (Desktop UI Demo)",
  "description": "דמו שולחני: שליטה על דיבוב בעברית, הנמכת וידאו ביוטיוב, וקול עברי בדפדפן.",
  "version": "0.2.0",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "SimulDub UI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
